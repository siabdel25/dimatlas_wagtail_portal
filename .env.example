# ── dimatlas_portal — variables d'environnement (copier en .env) ──────────
DJANGO_SETTINGS_MODULE=dimatlas_portal.settings.production
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=dimatlas.com,www.dimatlas.com
CSRF_TRUSTED_ORIGINS=https://dimatlas.com,https://www.dimatlas.com

# Base des liens vers les démos de l'ERP (apps verticales hors vitrine)
ERP_BASE_URL=https://app.dimatlas.com

# PostgreSQL (prod)
DB_NAME=dimatlas_portal
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432
